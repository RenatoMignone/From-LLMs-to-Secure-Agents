---
interface Props {
  firstChapterRoute: string;
  latestChapter: string;
  totalChapters: number;
  sections: Array<{
    title: string;
    href: string;
    count: number;
    firstChapter: string;
    latestChapter: string;
  }>;
}

const { firstChapterRoute, latestChapter, totalChapters, sections } = Astro.props;
---

<section class="start-section not-content" id="learning-path" aria-labelledby="learning-path-title">
  <div class="start-container">
    <div class="start-banner-card">
      <div class="start-content">
        <span class="start-eyebrow">Your learning path</span>
        <h2 class="start-heading" id="learning-path-title">Build the system model one section at a time</h2>
        <p class="start-description">
          Start with software boundaries, move through agent foundations and architectures, then study each building block. Security chapters follow after the functional system is clear.
        </p>
        <div class="start-progress-pill">
          <span class="progress-dot" aria-hidden="true"></span>
          <span><strong>{totalChapters} chapters published</strong> across {sections.length} sections · latest: {latestChapter}</span>
        </div>
      </div>
      <div class="start-action-wrap">
        <a href={firstChapterRoute} class="btn-start-primary" data-reading-link data-start-route={firstChapterRoute}>
          <span data-reading-label>Start with chapter 1</span>
          <span class="btn-arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </div>

    <ol class="path-grid" aria-label="Published learning path">
      {sections.map((section, index) => (
        <li class="path-card">
          <a href={section.href} aria-label={`Open ${section.title}, ${section.count} published chapters`}>
            <span class="path-step">{index === 0 ? 'Start here' : `Step ${index + 1}`}</span>
            <strong>{section.title}</strong>
            <span class="path-count">{section.count} published {section.count === 1 ? 'chapter' : 'chapters'}</span>
            <span class="path-range">From {section.firstChapter}<br />to {section.latestChapter}</span>
            <span class="path-link">View section <span aria-hidden="true">→</span></span>
          </a>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .start-section {
    width: 100%;
    padding: clamp(3rem, 6vh, 5rem) clamp(1.5rem, 4vw, 4.5rem);
    background-color: var(--color-canvas);
    box-sizing: border-box;
  }

  .start-container {
    width: 100%;
    max-width: 88rem;
    margin: 0 auto;
  }

  .path-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
    margin: 1rem 0 0;
    padding: 0;
  }

  .path-card {
    margin: 0;
  }

  .path-card a {
    min-height: 100%;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    padding: 1.25rem;
    color: var(--color-ink);
    text-decoration: none;
    background: var(--color-surface);
    border: 1.5px solid var(--color-border);
    border-radius: 14px;
    transition: transform 180ms ease, border-color 180ms ease, box-shadow 180ms ease;
  }

  .path-card a:hover {
    transform: translateY(-2px);
    border-color: var(--color-teal);
    box-shadow: 0 8px 22px var(--color-teal-subtle);
  }

  .path-step,
  .path-count {
    color: var(--color-teal);
    font-size: 0.76rem;
    font-weight: 750;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .path-card strong {
    font-family: var(--font-heading);
    font-size: 1.02rem;
  }

  .path-range {
    color: var(--color-ink-muted);
    font-size: 0.86rem;
    line-height: 1.5;
    margin-bottom: 0.55rem;
  }

  .path-link {
    margin-top: auto;
    color: var(--color-teal);
    font-size: 0.88rem;
    font-weight: 700;
  }

  .start-banner-card {
    background: linear-gradient(135deg, var(--color-surface) 0%, var(--color-surface-subtle) 100%);
    border: 1.5px solid var(--color-border);
    border-radius: 20px;
    padding: clamp(2.5rem, 5vw, 3.5rem);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 3rem;
    box-shadow: 0 10px 30px -4px rgba(0, 0, 0, 0.04);
  }

  :root[data-theme='dark'] .start-banner-card {
    background: linear-gradient(135deg, var(--color-surface-card) 0%, var(--color-surface-subtle) 100%);
    border-color: var(--color-border);
    box-shadow: 0 10px 36px -4px rgba(0, 0, 0, 0.4);
  }

  .start-content {
    max-width: 48rem;
  }

  .start-eyebrow {
    display: inline-block;
    color: var(--color-teal);
    font-size: 0.8rem;
    font-weight: 750;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 0.75rem;
  }

  :root[data-theme='dark'] .start-eyebrow {
    color: var(--color-lavender);
  }

  .start-heading {
    font-family: var(--font-heading);
    font-size: clamp(1.75rem, 2.8vw, 2.35rem);
    font-weight: 750;
    color: var(--color-ink);
    margin: 0 0 1rem;
    letter-spacing: -0.02em;
  }

  .start-description {
    font-size: 1.05rem;
    line-height: 1.62;
    color: var(--color-ink-muted);
    margin: 0 0 1.5rem;
  }

  .start-progress-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.35rem 0.85rem;
    border-radius: 9999px;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    font-size: 0.85rem;
    color: var(--color-ink-muted);
  }

  :root[data-theme='dark'] .start-progress-pill {
    background-color: var(--color-surface-subtle);
    border-color: var(--color-border);
  }

  .start-progress-pill strong {
    color: var(--color-ink);
  }

  .progress-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--color-teal);
    box-shadow: 0 0 0 2px var(--color-teal-subtle);
  }

  :root[data-theme='dark'] .progress-dot {
    background-color: var(--color-lavender);
    box-shadow: 0 0 0 2px rgba(203, 166, 247, 0.3);
  }

  .start-action-wrap {
    flex-shrink: 0;
  }

  .btn-start-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    padding: 1rem 2rem;
    border-radius: 14px;
    background: linear-gradient(135deg, #42948E 0%, #4F88AC 100%);
    color: #FFFFFF !important;
    font-family: var(--font-heading);
    font-size: 1.1rem;
    font-weight: 700;
    text-decoration: none !important;
    box-shadow: 0 6px 18px rgba(66, 148, 142, 0.32), inset 0 1px 0 rgba(255, 255, 255, 0.2);
    transition: all 180ms cubic-bezier(0.16, 1, 0.3, 1);
    white-space: nowrap;
    border: 1px solid rgba(255, 255, 255, 0.15);
  }

  :root[data-theme='dark'] .btn-start-primary {
    background: linear-gradient(135deg, #78C4BD 0%, #8AC2E4 100%);
    color: #141E26 !important;
    box-shadow: 0 6px 20px rgba(120, 196, 189, 0.32);
  }

  .btn-start-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 26px rgba(66, 148, 142, 0.42);
    background: linear-gradient(135deg, #377E79 0%, #437596 100%);
    color: #FFFFFF !important;
  }

  :root[data-theme='dark'] .btn-start-primary:hover {
    background: linear-gradient(135deg, #9BE0DA 0%, #AFDBF5 100%);
    color: #141E26 !important;
    box-shadow: 0 10px 28px rgba(120, 196, 189, 0.42);
  }

  .btn-arrow {
    transition: transform 160ms ease;
  }

  .btn-start-primary:hover .btn-arrow {
    transform: translateX(3px);
  }

  @media (max-width: 900px) {
    .path-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .start-banner-card {
      flex-direction: column;
      align-items: flex-start;
      gap: 2rem;
    }

    .start-action-wrap {
      width: 100%;
    }

    .btn-start-primary {
      width: 100%;
      justify-content: center;
    }
  }

  @media (max-width: 560px) {
    .start-section {
      padding-inline: 1rem;
    }

    .start-banner-card {
      padding: 1.5rem;
    }

    .start-progress-pill {
      align-items: flex-start;
      border-radius: 12px;
    }

    .path-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
