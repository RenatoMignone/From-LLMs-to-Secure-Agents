---
interface Props {
  githubUrl: string;
  baseUrl?: string;
}

const { githubUrl, baseUrl = '/From-LLMs-to-Secure-Agents' } = Astro.props;
---

<footer class="homepage-footer not-content">
  <div class="footer-container">
    <div class="footer-identity">
      <img src={`${baseUrl}/favicon-32x32.png`} alt="" width="32" height="32" />
      <div>
        <strong>From LLMs to Secure Agents</strong>
        <span>Written and maintained by Renato Mignone.</span>
      </div>
    </div>

    <nav aria-label="Project links">
      <a href={`${baseUrl}/curriculum/`}>Index</a>
      <a href={githubUrl} target="_blank" rel="noopener noreferrer">Source</a>
      <a href={`${githubUrl}/blob/main/docs/evidence-policy.md`} target="_blank" rel="noopener noreferrer">Evidence policy</a>
      <a href={`${githubUrl}/blob/main/LICENSE`} target="_blank" rel="noopener noreferrer">MIT license</a>
    </nav>
  </div>
</footer>

<style>
  .homepage-footer {
    box-sizing: border-box;
    width: 100%;
    padding: 2rem clamp(1.5rem, 4vw, 4.5rem);
    background: var(--color-surface);
  }

  :global(:root[data-theme='dark']) .homepage-footer {
    background: var(--color-canvas);
  }

  .footer-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    width: 100%;
    max-width: 88rem;
    margin: 0 auto;
  }

  .footer-identity {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .footer-identity img {
    flex: 0 0 auto;
    display: block;
    width: 2rem;
    height: 2rem;
    border-radius: 8px;
    object-fit: contain;
  }

  .footer-identity div {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .footer-identity strong {
    color: var(--color-ink);
    font-family: var(--font-heading);
    font-size: 0.92rem;
  }

  .footer-identity span {
    color: var(--color-ink-muted);
    font-size: 0.8rem;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.75rem 1.25rem;
  }

  nav a {
    color: var(--color-ink-muted);
    font-size: 0.85rem;
    font-weight: 650;
    text-decoration: none !important;
  }

  nav a:hover {
    color: var(--color-teal);
  }

  @media (max-width: 700px) {
    .homepage-footer {
      padding: 1.75rem 1rem 2rem;
    }

    .footer-container {
      flex-direction: column;
      align-items: flex-start;
      gap: 1.5rem;
    }

    nav {
      justify-content: flex-start;
    }
  }
</style>
