---
interface Props {
  githubUrl: string;
  baseUrl?: string;
}

const { githubUrl, baseUrl = '/From-LLMs-to-Secure-Agents' } = Astro.props;
---

<footer class="editorial-footer not-content">
  <div class="footer-container">
    <div class="footer-top">
      <div class="footer-brand-col">
        <div class="footer-logo-row">
          <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 36 36" fill="none">
            <rect x="4" y="8" width="28" height="22" rx="7" fill="#0D9488" />
            <rect x="6.5" y="10.5" width="23" height="17" rx="5" fill="#132B45" />
            <circle cx="18" cy="4" r="2" fill="#0D9488" />
            <path d="M18 6V8" stroke="#0D9488" stroke-width="2" stroke-linecap="round" />
            <circle cx="13.5" cy="19" r="2.2" fill="#5EEAD4" />
            <circle cx="22.5" cy="19" r="2.2" fill="#5EEAD4" />
            <path d="M16 23.5C16.8 24.5 19.2 24.5 20 23.5" stroke="#5EEAD4" stroke-width="1.4" stroke-linecap="round" />
          </svg>
          <span class="footer-brand-name">From LLMs to Secure Agents</span>
        </div>
        <p class="footer-tagline">
          A visual, source-grounded engineering guide to understanding complete agentic AI architectures and learning how to threat-model, sandbox, and secure them.
        </p>
      </div>

      <div class="footer-nav-grid">
        <div class="footer-col">
          <h4 class="footer-col-title">Creator</h4>
          <ul class="footer-links-list">
            <li>
              <a href="https://github.com/RenatoMignone" target="_blank" rel="noopener noreferrer" class="creator-link">
                <svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true" fill="currentColor">
                  <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"></path>
                </svg>
                <span>Follow @RenatoMignone</span>
              </a>
            </li>
            <li><a href="https://github.com/RenatoMignone" target="_blank" rel="noopener noreferrer">GitHub Profile</a></li>
            <li><a href="https://renatomignone.github.io/" target="_blank" rel="noopener noreferrer">Personal Website</a></li>
          </ul>
        </div>

        <div class="footer-col">
          <h4 class="footer-col-title">Sources &amp; Project</h4>
          <ul class="footer-links-list">
            <li><a href={`${baseUrl}/curriculum/`}>Index</a></li>
            <li><a href={githubUrl} target="_blank" rel="noopener noreferrer">GitHub Repository</a></li>
            <li><a href={`${githubUrl}/blob/main/docs/evidence-policy.md`} target="_blank" rel="noopener noreferrer">Evidence Policy</a></li>
            <li><a href={`${githubUrl}/blob/main/docs/visuals-policy.md`} target="_blank" rel="noopener noreferrer">Visuals Policy</a></li>
            <li><a href={`${githubUrl}/blob/main/LICENSE`} target="_blank" rel="noopener noreferrer">License (MIT)</a></li>
          </ul>
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <p class="footer-copy">
        Crafted by <strong>Renato Mignone</strong> for systems engineers, AI architects, and security researchers.
      </p>
      <p class="footer-rights">
        Open Source under MIT License · Grounded in verifiable specifications.
      </p>
    </div>
  </div>
</footer>

<style>
  .editorial-footer {
    width: 100%;
    padding: clamp(3rem, 5vh, 4.5rem) clamp(1.5rem, 4vw, 4.5rem) 2.5rem;
    border-top: 1px solid var(--color-border);
    background-color: var(--color-surface);
    box-sizing: border-box;
  }

  :root[data-theme='dark'] .editorial-footer {
    background-color: var(--color-canvas);
  }

  .footer-container {
    width: 100%;
    max-width: 88rem;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  /* Footer Links Grid */
  .footer-top {
    display: grid;
    grid-template-columns: 1.35fr 2fr;
    gap: clamp(2rem, 5vw, 5rem);
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .footer-logo-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.95rem;
  }

  .footer-brand-name {
    font-family: var(--font-heading);
    font-size: 1.08rem;
    font-weight: 800;
    color: var(--color-ink);
  }

  .footer-tagline {
    font-size: 0.92rem;
    line-height: 1.62;
    color: var(--color-ink-muted);
    max-width: 28rem;
    margin: 0;
  }

  .footer-nav-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2.5rem;
  }

  .footer-col-title {
    font-family: var(--font-heading);
    font-size: 0.82rem;
    font-weight: 750;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-ink);
    margin: 0 0 1rem;
  }

  .footer-links-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .footer-links-list a {
    font-size: 0.9rem;
    color: var(--color-ink-muted);
    text-decoration: none !important;
    transition: color 140ms ease, transform 140ms ease;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  .footer-links-list a:hover {
    color: var(--color-teal);
    transform: translateX(2px);
  }

  .creator-link {
    font-weight: 650;
    color: var(--color-ink) !important;
  }

  .creator-link:hover {
    color: var(--color-teal) !important;
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 0.25rem;
    flex-wrap: wrap;
    gap: 1rem;
    font-size: 0.85rem;
    color: var(--color-ink-light);
  }

  .footer-bottom p {
    margin: 0;
  }

  .footer-bottom strong {
    color: var(--color-ink);
  }

  @media (max-width: 860px) {
    .footer-top {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .footer-nav-grid {
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
    }
  }

  @media (max-width: 520px) {
    .footer-nav-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.4rem;
    }
  }
</style>
