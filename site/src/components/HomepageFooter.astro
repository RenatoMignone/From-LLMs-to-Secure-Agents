---
interface Props {
  githubUrl: string;
  baseUrl?: string;
}

const { githubUrl, baseUrl = '/From-LLMs-to-Secure-Agents' } = Astro.props;
---

<footer class="editorial-footer not-content">
  <div class="footer-container">
    {/* Author & Project Header Banner */}
    <div class="footer-author-card">
      <div class="author-profile">
        <div class="author-avatar-badge">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
            <circle cx="12" cy="7" r="4"></circle>
          </svg>
        </div>
        <div class="author-details">
          <div class="author-title-line">
            <span class="author-role-tag">Author &amp; Maintainer</span>
            <h3 class="author-name">Renato Mignone</h3>
          </div>
          <p class="author-bio">
            AI Systems &amp; Security Researcher. Author of <em>From LLMs to Secure Agents</em>, focused on runtime verification, trust boundaries, and defense-in-depth engineering for autonomous AI systems.
          </p>
        </div>
      </div>
      <div class="author-actions">
        <a href="https://github.com/RenatoMignone" target="_blank" rel="noopener noreferrer" class="btn-author-gh">
          <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" fill="currentColor">
            <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"></path>
          </svg>
          <span>Follow @RenatoMignone</span>
        </a>
      </div>
    </div>

    <div class="footer-top">
      <div class="footer-brand-col">
        <div class="footer-logo-row">
          <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 36 36" fill="none">
            <rect x="4" y="8" width="28" height="22" rx="7" fill="#0D9488" />
            <rect x="6.5" y="10.5" width="23" height="17" rx="5" fill="#132B45" />
            <circle cx="18" cy="4" r="2" fill="#0D9488" />
            <path d="M18 6V8" stroke="#0D9488" stroke-width="2" stroke-linecap="round" />
            <circle cx="13.5" cy="19" r="2.2" fill="#5EEAD4" />
            <circle cx="22.5" cy="19" r="2.2" fill="#5EEAD4" />
            <path d="M16 23.5C16.8 24.5 19.2 24.5 20 23.5" stroke="#5EEAD4" stroke-width="1.4" stroke-linecap="round" />
          </svg>
          <span class="footer-brand-name">From LLMs to Secure Agents</span>
        </div>
        <p class="footer-tagline">
          A visual, source-grounded engineering guide to understanding complete agentic AI architectures and learning how to threat-model, sandbox, and secure them.
        </p>
      </div>

      <div class="footer-nav-grid">
        <div class="footer-col">
          <h4 class="footer-col-title">Handbook Units</h4>
          <ul class="footer-links-list">
            <li><a href={`${baseUrl}/prerequisites/01-reader-contract-and-system-map/`}>Pass 0: Prerequisites</a></li>
            <li><a href={`${baseUrl}/foundations/01-what-is-an-agent/`}>Pass 1: Agent Foundations</a></li>
            <li><a href={`${baseUrl}/foundations/02-the-agent-loop/`}>The 5-Step Agent Loop</a></li>
            <li><a href={`${baseUrl}/prerequisites/02-data-control-and-trust-boundaries/`}>Trust Boundaries</a></li>
          </ul>
        </div>

        <div class="footer-col">
          <h4 class="footer-col-title">Machine &amp; AI (AEO)</h4>
          <ul class="footer-links-list">
            <li><a href={`${baseUrl}/llms.txt`} target="_blank" rel="noopener noreferrer">llms.txt Manifest</a></li>
            <li><a href={`${baseUrl}/llms-full.txt`} target="_blank" rel="noopener noreferrer">llms-full.txt (Full AI Dump)</a></li>
            <li><a href={`${baseUrl}/guide-index.json`} target="_blank" rel="noopener noreferrer">guide-index.json (API)</a></li>
            <li><a href={`${baseUrl}/robots.txt`} target="_blank" rel="noopener noreferrer">robots.txt Directives</a></li>
          </ul>
        </div>

        <div class="footer-col">
          <h4 class="footer-col-title">Project &amp; Sources</h4>
          <ul class="footer-links-list">
            <li><a href={githubUrl} target="_blank" rel="noopener noreferrer">GitHub Repository</a></li>
            <li><a href={`${githubUrl}/blob/main/docs/evidence-policy.md`} target="_blank" rel="noopener noreferrer">Evidence Policy</a></li>
            <li><a href={`${githubUrl}/blob/main/docs/visuals-policy.md`} target="_blank" rel="noopener noreferrer">Visuals Policy</a></li>
            <li><a href={`${githubUrl}/blob/main/LICENSE`} target="_blank" rel="noopener noreferrer">License (MIT)</a></li>
          </ul>
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <p class="footer-copy">
        Crafted with rigor by <strong>Renato Mignone</strong> for systems engineers, AI architects, and security researchers.
      </p>
      <p class="footer-rights">
        Open Source under MIT License · Grounded in verifiable specifications.
      </p>
    </div>
  </div>
</footer>

<style>
  .editorial-footer {
    width: 100%;
    padding: clamp(3.5rem, 6vh, 5.5rem) clamp(1.5rem, 4vw, 4.5rem) 3rem;
    border-top: 1px solid var(--color-border);
    background-color: var(--color-surface);
    box-sizing: border-box;
  }

  :root[data-theme='dark'] .editorial-footer {
    background-color: var(--color-canvas);
  }

  .footer-container {
    width: 100%;
    max-width: 100%;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
  }

  /* Author Card */
  .footer-author-card {
    background: linear-gradient(135deg, var(--color-surface-subtle) 0%, var(--color-surface) 100%);
    border: 1.5px solid var(--color-border);
    border-radius: 18px;
    padding: clamp(1.75rem, 3vw, 2.25rem);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 2rem;
    box-shadow: 0 4px 14px -2px rgba(0, 0, 0, 0.03);
  }

  :root[data-theme='dark'] .footer-author-card {
    background: linear-gradient(135deg, #1E293B 0%, #151D2A 100%);
    box-shadow: 0 4px 16px -2px rgba(0, 0, 0, 0.25);
  }

  .author-profile {
    display: flex;
    align-items: flex-start;
    gap: 1.25rem;
    max-width: 52rem;
  }

  .author-avatar-badge {
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 50%;
    background-color: var(--color-teal-subtle);
    color: var(--color-teal);
    border: 1.5px solid var(--color-teal-border);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .author-details {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .author-title-line {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    flex-wrap: wrap;
  }

  .author-role-tag {
    font-size: 0.75rem;
    font-weight: 750;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0.15rem 0.5rem;
    border-radius: 6px;
    background-color: var(--color-teal-subtle);
    color: var(--color-teal);
    border: 1px solid var(--color-teal-border);
  }

  .author-name {
    font-family: var(--font-heading);
    font-size: 1.2rem;
    font-weight: 800;
    color: var(--color-ink);
    margin: 0;
  }

  .author-bio {
    font-size: 0.94rem;
    line-height: 1.6;
    color: var(--color-ink-muted);
    margin: 0;
  }

  .author-bio em {
    color: var(--color-ink);
    font-style: normal;
    font-weight: 600;
  }

  .author-actions {
    flex-shrink: 0;
  }

  .btn-author-gh {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.65rem 1.25rem;
    border-radius: 10px;
    background: linear-gradient(135deg, #24292f 0%, #101418 100%);
    color: #FFFFFF !important;
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none !important;
    border: 1px solid rgba(255, 255, 255, 0.15);
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.15);
    transition: all 160ms cubic-bezier(0.16, 1, 0.3, 1);
    white-space: nowrap;
  }

  :root[data-theme='dark'] .btn-author-gh {
    background: linear-gradient(135deg, #334155 0%, #1E293B 100%);
  }

  .btn-author-gh:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.3);
    color: #FFFFFF !important;
  }

  /* Footer Links Grid */
  .footer-top {
    display: grid;
    grid-template-columns: 1.25fr 2fr;
    gap: 4rem;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .footer-logo-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .footer-brand-name {
    font-family: var(--font-heading);
    font-size: 1.05rem;
    font-weight: 750;
    color: var(--color-ink);
  }

  .footer-tagline {
    font-size: 0.92rem;
    line-height: 1.62;
    color: var(--color-ink-muted);
    max-width: 26rem;
    margin: 0;
  }

  .footer-nav-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .footer-col-title {
    font-family: var(--font-heading);
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-ink);
    margin: 0 0 1.15rem;
  }

  .footer-links-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .footer-links-list a {
    font-size: 0.9rem;
    color: var(--color-ink-muted);
    text-decoration: none !important;
    transition: color 140ms ease;
  }

  .footer-links-list a:hover {
    color: var(--color-teal);
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 0.5rem;
    flex-wrap: wrap;
    gap: 1rem;
    font-size: 0.86rem;
    color: var(--color-ink-light);
  }

  .footer-bottom p {
    margin: 0;
  }

  .footer-bottom strong {
    color: var(--color-ink);
  }

  @media (max-width: 960px) {
    .footer-author-card {
      flex-direction: column;
      align-items: flex-start;
      gap: 1.5rem;
    }

    .author-actions {
      width: 100%;
    }

    .btn-author-gh {
      width: 100%;
      justify-content: center;
    }

    .footer-top {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }

  @media (max-width: 640px) {
    .footer-nav-grid {
      grid-template-columns: 1fr;
      gap: 1.75rem;
    }

    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
    }
  }
</style>
