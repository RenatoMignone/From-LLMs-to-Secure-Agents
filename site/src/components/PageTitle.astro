---
const PAGE_TITLE_ID = '_top';
const entry = Astro.locals.starlightRoute?.entry;
const isHomepage = !entry || entry.slug === '' || entry.data?.template === 'splash';
const title = entry?.data?.title;
const summary = entry?.data?.summary;
const chapterLabel = entry?.data?.chapter_label;
const sectionLabel = entry?.data?.section_label;
const learningPath = entry?.data?.learning_path;
const reviewedLabel = entry?.data?.reviewed_label;

const pathLabel = learningPath === 'deep_dive' || learningPath === 'deep-dive' ? 'Deep dive' : 'Main path';
---

{
  !isHomepage && title && (
    <header class="chapter-heading">
      {chapterLabel ? (
        <div class="chapter-meta-line">
          <span class="meta-unit">{chapterLabel}</span>
          {sectionLabel && <><span class="meta-sep" aria-hidden="true">·</span><span class="meta-badge">{sectionLabel}</span></>}
          <span class="meta-sep" aria-hidden="true">·</span>
          <span class="meta-badge">{pathLabel}</span>
          {reviewedLabel && <><span class="meta-sep" aria-hidden="true">·</span><span class="meta-date">Reviewed {reviewedLabel}</span></>}
        </div>
      ) : null}
      <h1 id={PAGE_TITLE_ID} class="chapter-page-title">{title}</h1>
      {summary && <p class="chapter-standfirst">{summary}</p>}
    </header>
  )
}

<style>
  .chapter-heading {
    width: 100%;
    margin-bottom: 2.25rem;
  }

  .chapter-meta-line {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin-bottom: 1.35rem;
    font-size: 0.85rem;
    line-height: 1.5;
  }

  .meta-unit {
    color: var(--color-teal);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 750;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.25rem 0.75rem;
    border-radius: 9999px;
    background-color: var(--color-teal-subtle);
    border: 1px solid var(--color-teal-border);
  }

  .meta-badge {
    color: var(--color-ink-muted);
    font-size: 0.76rem;
    font-weight: 650;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.22rem 0.7rem;
    border-radius: 9999px;
    background-color: var(--color-surface-subtle);
    border: 1px solid var(--color-border);
  }

  .meta-sep {
    display: none;
  }

  .meta-date {
    color: var(--color-ink-light);
    font-size: 0.82rem;
    padding-left: 0.25rem;
  }

  .chapter-page-title {
    font-family: var(--font-heading);
    font-size: clamp(2.2rem, 3.8vw, 3.2rem);
    font-weight: 800;
    line-height: 1.15;
    color: var(--color-ink);
    margin: 0 0 1.25rem;
    letter-spacing: -0.03em;
  }

  .chapter-standfirst {
    max-width: 58rem;
    margin: 0;
    color: var(--color-ink-muted);
    font-size: clamp(1.15rem, 1.8vw, 1.28rem);
    line-height: 1.62;
  }

  @media (max-width: 640px) {
    .chapter-page-title {
      font-size: 2.1rem;
    }
    .chapter-standfirst {
      font-size: 1.1rem;
    }
  }
</style>
