---
interface Props {
  firstChapterRoute: string;
  baseUrl: string;
  image: {
    width: number;
    height: number;
    variants: Array<{ width: number; path: string }>;
  };
}

const { firstChapterRoute, baseUrl, image } = Astro.props;
const largestImage = image.variants.at(-1);
const imageSrcset = image.variants
  .map((variant) => `${baseUrl}/assets/images/${variant.path} ${variant.width}w`)
  .join(', ');
---

<section class="hero-section not-content">
  <div class="hero-container">
    <div class="hero-copy">
      <h1 id="_top" class="hero-heading">Agentic AI and its security</h1>
      <p class="hero-lead">
        A comprehensive, sequential guide to the architecture, operation, risks, and defenses of agentic systems.
      </p>

      <div class="hero-actions">
        <a href={firstChapterRoute} class="btn-hero-primary" data-reading-link data-start-route={firstChapterRoute}>
          <span data-reading-label>Start with prerequisites</span>
          <span class="btn-arrow" aria-hidden="true">→</span>
        </a>
        <a href={`${baseUrl}/curriculum/`} class="btn-hero-secondary">
          <span>Browse the index</span>
          <span class="btn-arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </div>

    <figure class="hero-visual">
      <picture>
        <source type="image/webp" srcset={imageSrcset} sizes="(max-width: 60rem) calc(100vw - 2rem), 48vw" />
        <img
          src={`${baseUrl}/assets/images/${largestImage.path}`}
          alt="The guide progresses from a language model to a complete agentic system, then revisits that system with security boundaries and runtime controls"
          width={image.width}
          height={image.height}
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
      </picture>
    </figure>
  </div>
</section>

<style>
  .hero-section {
    box-sizing: border-box;
    width: 100%;
    padding: clamp(3.5rem, 7vh, 5.5rem) clamp(1.5rem, 4vw, 4.5rem) clamp(4rem, 8vh, 6rem);
    background:
      radial-gradient(circle at 12% 18%, rgba(47, 117, 111, 0.1), transparent 40%),
      radial-gradient(circle at 88% 74%, rgba(229, 142, 88, 0.08), transparent 42%);
  }

  :global(:root[data-theme='dark']) .hero-section {
    background:
      radial-gradient(circle at 12% 18%, rgba(120, 196, 189, 0.11), transparent 40%),
      radial-gradient(circle at 88% 74%, rgba(240, 166, 120, 0.08), transparent 42%);
  }

  .hero-container {
    display: grid;
    grid-template-columns: minmax(19rem, 0.82fr) minmax(0, 1.18fr);
    align-items: center;
    gap: clamp(3rem, 6vw, 7rem);
    width: 100%;
    max-width: 88rem;
    margin: 0 auto;
  }

  .hero-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .hero-heading {
    max-width: 11ch;
    margin: 0 0 1.35rem;
    color: var(--color-ink);
    font-family: var(--font-heading);
    font-size: clamp(2.8rem, 4.8vw, 4.8rem);
    font-weight: 800;
    letter-spacing: -0.045em;
    line-height: 1.02;
  }

  .hero-heading::after {
    display: block;
    width: clamp(4rem, 8vw, 7rem);
    height: 0.32rem;
    margin-top: 1.45rem;
    border-radius: 999px;
    background: linear-gradient(90deg, var(--color-teal), var(--color-peach));
    content: '';
  }

  .hero-lead {
    max-width: 38rem;
    margin: 0 0 2.2rem;
    color: var(--color-ink-muted);
    font-size: clamp(1.08rem, 1.35vw, 1.25rem);
    line-height: 1.65;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.8rem;
  }

  .btn-hero-primary,
  .btn-hero-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    min-height: 2.8rem;
    padding: 0.68rem 1.2rem;
    border-radius: 12px;
    font-family: var(--font-heading);
    font-size: 0.93rem;
    font-weight: 700;
    line-height: 1;
    text-decoration: none !important;
    white-space: nowrap;
    transition: transform 160ms ease, border-color 160ms ease, background-color 160ms ease, box-shadow 160ms ease;
  }

  .btn-hero-primary {
    border: 1px solid rgba(255, 255, 255, 0.2);
    background: linear-gradient(135deg, #387b75 0%, #4d849b 100%);
    box-shadow: 0 5px 16px rgba(56, 123, 117, 0.22);
    color: #ffffff !important;
  }

  :global(:root[data-theme='dark']) .btn-hero-primary {
    border-color: rgba(255, 255, 255, 0.24);
    background: linear-gradient(135deg, #78c4bd 0%, #8ac2e4 100%);
    box-shadow: 0 5px 18px rgba(120, 196, 189, 0.2);
    color: #141e26 !important;
  }

  .btn-hero-secondary {
    border: 1px solid var(--color-border);
    background: color-mix(in srgb, var(--color-surface) 84%, transparent);
    color: var(--color-ink) !important;
  }

  .btn-hero-primary:hover,
  .btn-hero-secondary:hover {
    transform: translateY(-2px);
  }

  .btn-hero-primary:hover {
    box-shadow: 0 9px 22px rgba(56, 123, 117, 0.3);
  }

  .btn-hero-secondary:hover {
    border-color: var(--color-teal);
    background: var(--color-teal-subtle);
    color: var(--color-teal) !important;
  }

  .btn-hero-primary:active,
  .btn-hero-secondary:active {
    transform: translateY(0);
  }

  .btn-arrow {
    transition: transform 160ms ease;
  }

  .btn-hero-primary:hover .btn-arrow,
  .btn-hero-secondary:hover .btn-arrow {
    transform: translateX(3px);
  }

  .hero-visual {
    position: relative;
    width: 100%;
    margin: 0;
    padding: clamp(0.45rem, 1vw, 0.75rem);
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: 16px;
    background: linear-gradient(145deg, var(--color-surface), var(--card-gradient-end));
    box-shadow: 0 18px 48px rgba(30, 70, 77, 0.1);
  }

  :global(:root[data-theme='dark']) .hero-visual {
    background: linear-gradient(145deg, var(--color-surface-card), var(--color-surface-subtle));
    box-shadow: 0 20px 52px rgba(0, 0, 0, 0.32);
  }

  .hero-visual img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 11px;
  }

  @media (max-width: 960px) {
    .hero-section {
      padding-top: 3.25rem;
    }

    .hero-container {
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    .hero-copy {
      max-width: 43rem;
    }

    .hero-heading {
      max-width: 14ch;
    }
  }

  @media (max-width: 640px) {
    .hero-section {
      padding: 2.5rem 1rem 3.5rem;
    }

    .hero-container {
      gap: 2.5rem;
    }

    .hero-heading {
      max-width: 12ch;
      font-size: clamp(2.45rem, 13vw, 3.5rem);
    }

    .hero-heading::after {
      margin-top: 1.15rem;
    }

    .hero-lead {
      margin-bottom: 1.8rem;
      font-size: 1.05rem;
    }

    .hero-actions {
      display: grid;
      grid-template-columns: 1fr;
      width: 100%;
    }

    .btn-hero-primary,
    .btn-hero-secondary {
      width: 100%;
      min-height: 3rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .btn-hero-primary,
    .btn-hero-secondary,
    .btn-arrow {
      transition: none;
    }
  }
</style>
