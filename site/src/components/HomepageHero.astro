---
interface Props {
  firstChapterRoute: string;
  baseUrl: string;
  image: {
    width: number;
    height: number;
    variants: Array<{ width: number; path: string }>;
  };
}

const { firstChapterRoute, baseUrl, image } = Astro.props;
const largestImage = image.variants.at(-1);
const imageSrcset = image.variants
  .map((variant) => `${baseUrl}/assets/images/${variant.path} ${variant.width}w`)
  .join(', ');
---

<section class="hero-section not-content">
  <div class="hero-container">
    <div class="hero-copy">
      <p class="hero-status">
        <span aria-hidden="true"></span>
        Early alpha · Architecture pass in progress
      </p>
      <h1 id="_top" class="hero-heading">
        Understand the complete agentic system first.<br />
        <span class="hero-accent-text">Then learn how to secure it.</span>
      </h1>

      <p class="hero-lead">
        Start with the published architecture chapters. The threat modeling and security path will follow as reviewed material, not as finished guidance presented too early.
      </p>

      <div class="hero-actions">
        <a href={firstChapterRoute} class="btn-hero-primary" data-reading-link data-start-route={firstChapterRoute}>
          <span data-reading-label>Start reading</span>
          <span class="btn-arrow" aria-hidden="true">→</span>
        </a>
        <a href="#the-idea" class="btn-hero-secondary">
          <span>Why this guide exists</span>
          <span class="btn-arrow" aria-hidden="true">↓</span>
        </a>
      </div>
    </div>

    <div class="hero-visual">
      <div class="visual-card">
        <div class="visual-card-header">
          <div class="visual-dots" aria-hidden="true">
            <span class="window-dot red"></span>
            <span class="window-dot yellow"></span>
            <span class="window-dot green"></span>
          </div>
          <span class="visual-title">Agent Architecture &amp; Security Evolution</span>
        </div>
        <div class="visual-image-wrapper">
          <picture>
            <source type="image/webp" srcset={imageSrcset} sizes="(max-width: 60rem) calc(100vw - 2.3rem), 44vw" />
            <img
              src={`${baseUrl}/assets/images/${largestImage.path}`}
              alt="The progression from a language model to a complete agentic system and then a hardened secure agent"
              width={image.width}
              height={image.height}
              loading="eager"
              decoding="async"
              fetchpriority="high"
            />
          </picture>
        </div>
        <div class="visual-card-footer">
          <p>From one model call to a complete agentic system, then to a hardened secure agent.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    width: 100%;
    padding: clamp(3.5rem, 7vh, 6rem) clamp(1.5rem, 4vw, 4.5rem);
    background: radial-gradient(circle at 15% 15%, rgba(66, 148, 142, 0.08), transparent 45%),
                radial-gradient(circle at 85% 75%, rgba(229, 142, 88, 0.07), transparent 45%);
    box-sizing: border-box;
  }

  :global(:root[data-theme='dark']) .hero-section {
    background: radial-gradient(circle at 15% 15%, rgba(120, 196, 189, 0.1), transparent 45%),
                radial-gradient(circle at 85% 75%, rgba(240, 166, 120, 0.08), transparent 45%);
  }

  .hero-container {
    width: 100%;
    max-width: 88rem;
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 1.18fr) minmax(0, 1fr);
    gap: clamp(2.5rem, 5vw, 6rem);
    align-items: center;
  }

  .hero-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .hero-status {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin: 0 0 1rem;
    padding: 0.4rem 0.7rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-surface);
    color: var(--color-ink-muted);
    font-family: var(--font-heading);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.035em;
    text-transform: uppercase;
  }

  .hero-status span {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--color-peach);
    box-shadow: 0 0 0 0.2rem color-mix(in srgb, var(--color-peach) 18%, transparent);
  }

  .hero-heading {
    font-family: var(--font-heading);
    font-size: clamp(2.4rem, 3.8vw, 4.1rem);
    font-weight: 800;
    line-height: 1.12;
    color: var(--color-ink);
    margin: 0 0 1.5rem;
    letter-spacing: -0.035em;
  }

  .hero-accent-text {
    background: linear-gradient(135deg, var(--color-teal) 0%, var(--color-peach) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    display: inline-block;
  }

  :global(:root[data-theme='dark']) .hero-accent-text {
    background: linear-gradient(135deg, #78C4BD 0%, #8AC2E4 50%, #F0A678 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-lead {
    font-size: clamp(1.12rem, 1.4vw, 1.3rem);
    line-height: 1.68;
    color: var(--color-ink-muted);
    max-width: 50rem;
    margin: 0 0 2.5rem;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: 1.15rem;
    flex-wrap: wrap;
  }

  .btn-hero-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.95rem 1.85rem;
    border-radius: 14px;
    background: linear-gradient(135deg, #42948E 0%, #4F88AC 100%);
    color: #FFFFFF !important;
    font-family: var(--font-heading);
    font-size: 1.08rem;
    font-weight: 700;
    text-decoration: none !important;
    box-shadow: 0 6px 18px rgba(66, 148, 142, 0.32), inset 0 1px 0 rgba(255, 255, 255, 0.2);
    transition: all 180ms cubic-bezier(0.16, 1, 0.3, 1);
    border: 1px solid rgba(255, 255, 255, 0.15);
  }

  :global(:root[data-theme='dark']) .btn-hero-primary {
    background: linear-gradient(135deg, #78C4BD 0%, #8AC2E4 100%);
    color: #141E26 !important;
    border-color: rgba(255, 255, 255, 0.25);
    box-shadow: 0 6px 20px rgba(120, 196, 189, 0.32);
  }

  .btn-hero-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 24px rgba(66, 148, 142, 0.42);
    background: linear-gradient(135deg, #377E79 0%, #437596 100%);
    color: #FFFFFF !important;
  }

  :global(:root[data-theme='dark']) .btn-hero-primary:hover {
    background: linear-gradient(135deg, #9BE0DA 0%, #AFDBF5 100%);
    color: #141E26 !important;
    box-shadow: 0 10px 26px rgba(120, 196, 189, 0.42);
  }

  .btn-hero-secondary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.95rem 1.65rem;
    border-radius: 14px;
    background-color: var(--color-surface);
    color: var(--color-ink) !important;
    font-family: var(--font-heading);
    font-size: 1.05rem;
    font-weight: 650;
    text-decoration: none !important;
    border: 1.5px solid var(--color-border);
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.03);
    transition: all 180ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  :global(:root[data-theme='dark']) .btn-hero-secondary {
    background-color: var(--color-surface-card);
    border-color: var(--color-border);
  }

  .btn-hero-secondary:hover {
    transform: translateY(-2px);
    border-color: var(--color-teal);
    color: var(--color-teal) !important;
    box-shadow: 0 6px 16px var(--color-teal-subtle);
  }

  :global(:root[data-theme='dark']) .btn-hero-secondary:hover {
    border-color: var(--color-teal);
    color: var(--color-teal) !important;
    box-shadow: 0 6px 16px rgba(120, 196, 189, 0.2);
  }

  .btn-arrow {
    transition: transform 160ms ease;
  }

  .btn-hero-primary:hover .btn-arrow {
    transform: translateX(3px);
  }

  .btn-hero-secondary:hover .btn-arrow {
    transform: translateY(2px);
  }

  /* Right Visual Card */
  .hero-visual {
    width: 100%;
  }

  .visual-card {
    width: 100%;
    border-radius: 18px;
    background-color: var(--color-surface);
    border: 1.5px solid var(--color-border);
    box-shadow: 0 14px 40px -6px rgba(0, 0, 0, 0.08);
    overflow: hidden;
    transition: transform 220ms ease, box-shadow 220ms ease;
  }

  :global(:root[data-theme='dark']) .visual-card {
    background-color: var(--color-surface-card);
    border-color: var(--color-border);
    box-shadow: 0 16px 44px -6px rgba(0, 0, 0, 0.45);
  }

  .visual-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 20px 52px -6px var(--color-teal-subtle);
  }

  :global(:root[data-theme='dark']) .visual-card:hover {
    box-shadow: 0 20px 52px -6px rgba(120, 196, 189, 0.22);
  }

  .visual-card-header {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.85rem 1.25rem;
    background-color: var(--color-surface-subtle);
    border-bottom: 1px solid var(--color-border);
  }

  .visual-dots {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .window-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
  }

  .window-dot.red { background-color: #E26D7D; }
  .window-dot.yellow { background-color: #E5B25D; }
  .window-dot.green { background-color: #6CAE83; }

  .visual-title {
    font-family: var(--font-heading);
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-ink-muted);
  }

  .visual-image-wrapper {
    width: 100%;
    background-color: var(--color-surface);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.5rem;
  }

  :global(:root[data-theme='dark']) .visual-image-wrapper {
    background-color: var(--color-surface-card);
  }

  .visual-image-wrapper img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 10px;
  }

  .visual-card-footer {
    padding: 0.85rem 1.25rem;
    background-color: var(--color-surface-subtle);
    border-top: 1px solid var(--color-border);
  }

  .visual-card-footer p {
    font-size: 0.86rem;
    line-height: 1.5;
    color: var(--color-ink-muted);
    margin: 0;
    text-align: center;
    font-style: italic;
  }

  @media (max-width: 960px) {
    .hero-container {
      grid-template-columns: 1fr;
      gap: 3.5rem;
    }
  }

  @media (max-width: 640px) {
    .hero-section {
      padding: 3rem 1.15rem 4rem;
    }

    .hero-actions {
      flex-direction: column;
      width: 100%;
    }

    .hero-heading br {
      display: none;
    }

    .btn-hero-primary,
    .btn-hero-secondary {
      width: 100%;
      justify-content: center;
    }
  }
</style>
