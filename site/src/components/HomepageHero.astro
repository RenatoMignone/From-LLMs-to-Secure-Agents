---
interface Props {
  firstChapterRoute: string;
  baseUrl: string;
}

const { firstChapterRoute, baseUrl } = Astro.props;
---

<section class="hero-section not-content">
  <div class="hero-container">
    <div class="hero-copy">
      <div class="hero-badge">
        <span class="badge-pulse"></span>
        <span class="badge-text">Interactive Engineering Handbook · 2-Pass Architecture</span>
      </div>

      <h1 class="hero-heading">
        Understand the complete agentic system first.<br />
        <span class="hero-accent-text">Then learn how to secure it.</span>
      </h1>

      <p class="hero-lead">
        A visual, source-grounded engineering guide to the architecture, runtime control loops, tool interfaces, threat modeling, and defense in depth of autonomous AI agents.
      </p>

      <div class="hero-actions">
        <a href={firstChapterRoute} class="btn-hero-primary">
          <span>Start Reading Guide</span>
          <span class="btn-arrow" aria-hidden="true">→</span>
        </a>
        <a href="#the-idea" class="btn-hero-secondary">
          <span>Why This Guide Is Needed</span>
          <span class="btn-arrow" aria-hidden="true">↓</span>
        </a>
      </div>

      <div class="hero-feature-pills">
        <div class="feature-pill">
          <span class="pill-dot pill-teal"></span>
          <span>9 Published Units</span>
        </div>
        <div class="feature-pill">
          <span class="pill-dot pill-amber"></span>
          <span>100% Grounded Sources</span>
        </div>
        <div class="feature-pill">
          <span class="pill-dot pill-lavender"></span>
          <span>Cartoon System Schemas</span>
        </div>
        <div class="feature-pill">
          <span class="pill-dot pill-sage"></span>
          <span>Machine-Readable AEO</span>
        </div>
      </div>
    </div>

    <div class="hero-visual">
      <div class="visual-card">
        <div class="visual-card-header">
          <div class="visual-dots">
            <span class="window-dot red"></span>
            <span class="window-dot yellow"></span>
            <span class="window-dot green"></span>
          </div>
          <span class="visual-title">Agent Architecture &amp; Security Evolution</span>
        </div>
        <div class="visual-image-wrapper">
          <img
            src={`${baseUrl}/assets/images/repo-images/project-purpose.png`}
            alt="The progression from a raw language model to a complete agentic system and then a hardened secure agent"
            loading="eager"
          />
        </div>
        <div class="visual-card-footer">
          <p>From one model call to a complete agentic system, then to a hardened secure agent.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    width: 100%;
    padding: clamp(3rem, 6vh, 5.5rem) clamp(1.5rem, 4vw, 4.5rem);
    background: radial-gradient(circle at 15% 15%, rgba(13, 148, 136, 0.06), transparent 45%),
                radial-gradient(circle at 85% 75%, rgba(139, 92, 246, 0.05), transparent 45%);
    box-sizing: border-box;
  }

  .hero-container {
    width: 100%;
    max-width: 100%;
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 1.18fr) minmax(0, 1fr);
    gap: clamp(2.5rem, 5vw, 6rem);
    align-items: center;
  }

  .hero-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.4rem 0.95rem;
    border-radius: 9999px;
    background-color: var(--color-teal-subtle);
    border: 1px solid var(--color-teal-border);
    margin-bottom: 1.5rem;
  }

  .badge-pulse {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--color-teal);
    box-shadow: 0 0 0 2px rgba(13, 148, 136, 0.25);
  }

  .badge-text {
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--color-teal);
  }

  .hero-heading {
    font-family: var(--font-heading);
    font-size: clamp(2.4rem, 3.8vw, 4rem);
    font-weight: 800;
    line-height: 1.1;
    color: var(--color-ink);
    margin: 0 0 1.5rem;
    letter-spacing: -0.035em;
  }

  .hero-accent-text {
    background: linear-gradient(135deg, var(--color-teal) 0%, #0891b2 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    display: inline-block;
  }

  :global(:root[data-theme='dark']) .hero-accent-text {
    background: linear-gradient(135deg, #5EEAD4 0%, #93C5FD 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-lead {
    font-size: clamp(1.1rem, 1.4vw, 1.3rem);
    line-height: 1.68;
    color: var(--color-ink-muted);
    max-width: 52rem;
    margin: 0 0 2.5rem;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: 1.15rem;
    flex-wrap: wrap;
    margin-bottom: 2.75rem;
  }

  .btn-hero-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.95rem 1.85rem;
    border-radius: 12px;
    background: linear-gradient(135deg, #0D9488 0%, #0f766e 100%);
    color: #FFFFFF !important;
    font-family: var(--font-heading);
    font-size: 1.08rem;
    font-weight: 700;
    text-decoration: none !important;
    box-shadow: 0 4px 14px rgba(13, 148, 136, 0.35), inset 0 1px 0 rgba(255, 255, 255, 0.2);
    transition: all 180ms cubic-bezier(0.16, 1, 0.3, 1);
    border: 1px solid rgba(255, 255, 255, 0.15);
  }

  :global(:root[data-theme='dark']) .btn-hero-primary {
    background: linear-gradient(135deg, #14B8A6 0%, #0D9488 100%);
    box-shadow: 0 4px 16px rgba(20, 184, 166, 0.35);
  }

  .btn-hero-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 22px rgba(13, 148, 136, 0.45);
    background: linear-gradient(135deg, #0F766E 0%, #115E59 100%);
    color: #FFFFFF !important;
  }

  .btn-hero-secondary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.95rem 1.65rem;
    border-radius: 12px;
    background-color: var(--color-surface);
    color: var(--color-ink) !important;
    font-family: var(--font-heading);
    font-size: 1.05rem;
    font-weight: 600;
    text-decoration: none !important;
    border: 1.5px solid var(--color-border);
    box-shadow: 0 2px 5px rgba(0, 0, 0, 0.04);
    transition: all 180ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .btn-hero-secondary:hover {
    transform: translateY(-2px);
    border-color: var(--color-teal);
    color: var(--color-teal) !important;
    box-shadow: 0 4px 12px rgba(13, 148, 136, 0.15);
  }

  .btn-arrow {
    transition: transform 160ms ease;
  }

  .btn-hero-primary:hover .btn-arrow {
    transform: translateX(3px);
  }

  .btn-hero-secondary:hover .btn-arrow {
    transform: translateY(2px);
  }

  .hero-feature-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
  }

  .feature-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.85rem;
    border-radius: 8px;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border-subtle);
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--color-ink-muted);
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.02);
  }

  :global(:root[data-theme='dark']) .feature-pill {
    background-color: var(--color-surface-subtle);
  }

  .pill-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
  }

  .pill-teal { background-color: var(--color-teal); }
  .pill-amber { background-color: #F59E0B; }
  .pill-lavender { background-color: #8B5CF6; }
  .pill-sage { background-color: #10B981; }

  /* Right Visual Card */
  .hero-visual {
    width: 100%;
  }

  .visual-card {
    width: 100%;
    background-color: var(--color-surface);
    border: 1.5px solid var(--color-border);
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 14px 40px -6px rgba(0, 0, 0, 0.08), 0 4px 12px -2px rgba(0, 0, 0, 0.03);
    transition: transform 220ms ease, box-shadow 220ms ease;
  }

  :global(:root[data-theme='dark']) .visual-card {
    background-color: var(--color-surface-subtle);
    box-shadow: 0 14px 44px -6px rgba(0, 0, 0, 0.4);
  }

  .visual-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 20px 52px -6px rgba(13, 148, 136, 0.16);
  }

  .visual-card-header {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.85rem 1.35rem;
    background-color: var(--color-surface-subtle);
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .visual-dots {
    display: flex;
    gap: 0.35rem;
  }

  .window-dot {
    width: 11px;
    height: 11px;
    border-radius: 50%;
  }

  .window-dot.red { background-color: #EF4444; opacity: 0.85; }
  .window-dot.yellow { background-color: #F59E0B; opacity: 0.85; }
  .window-dot.green { background-color: #10B981; opacity: 0.85; }

  .visual-title {
    font-size: 0.85rem;
    font-weight: 650;
    color: var(--color-ink-muted);
  }

  .visual-image-wrapper {
    padding: 1.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    background: radial-gradient(circle at center, rgba(13, 148, 136, 0.04), transparent 70%);
  }

  .visual-image-wrapper img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 12px;
    border: 1px solid var(--color-border-subtle);
    background-color: #FFFFFF;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
  }

  :global(:root[data-theme='dark']) .visual-image-wrapper img {
    background-color: #0F172A;
  }

  .visual-card-footer {
    padding: 0.85rem 1.35rem;
    background-color: var(--color-surface-subtle);
    border-top: 1px solid var(--color-border-subtle);
  }

  .visual-card-footer p {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--color-ink-muted);
    text-align: center;
  }

  @media (max-width: 1024px) {
    .hero-container {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
  }

  @media (max-width: 640px) {
    .hero-section {
      padding: 2.25rem 1rem 3.5rem;
    }

    .hero-heading {
      font-size: 2.2rem;
    }

    .hero-actions {
      flex-direction: column;
      width: 100%;
    }

    .btn-hero-primary,
    .btn-hero-secondary {
      width: 100%;
      justify-content: center;
    }
  }
</style>
