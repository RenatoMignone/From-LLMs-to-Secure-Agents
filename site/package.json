{
  "name": "from-llms-to-secure-agents-site",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.19.0"
  },
  "type": "module",
  "scripts": {
    "dev": "node scripts/build-pipeline.mjs && astro dev",
    "build:content": "node scripts/build-pipeline.mjs",
    "build": "node scripts/build-pipeline.mjs && astro build --force",
    "preview": "astro preview",
    "check": "node scripts/check-site.mjs",
    "test": "node --test scripts/tests/*.test.mjs",
    "quality": "npm test && npm run build && npm run check"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/starlight": "^0.42.6",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.1",
    "astro": "^7.4.0",
    "sharp": "^0.35.5",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "postcss-nested": {
      "postcss-selector-parser": "^7.1.6"
    }
  }
}
