{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "current_phase",
    "current_unit",
    "current_unit_path",
    "current_unit_state",
    "blocked_from",
    "completed_through",
    "units_in_review",
    "next_recommended_unit",
    "blockers",
    "unresolved_research_questions",
    "last_validation_date"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "current_phase": {"type": "string", "minLength": 1},
    "current_unit": {"type": ["string", "null"]},
    "current_unit_path": {"type": ["string", "null"]},
    "current_unit_state": {"enum": ["idle", "researching", "drafting", "building-assets", "validating", "review", "blocked"]},
    "blocked_from": {"type": ["string", "null"], "enum": [null, "researching", "drafting", "building-assets", "validating", "review"]},
    "completed_through": {"type": ["string", "null"]},
    "units_in_review": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "next_recommended_unit": {"type": ["string", "null"]},
    "blockers": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "unresolved_research_questions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "last_validation_date": {"type": "string", "format": "date"}
  }
}
