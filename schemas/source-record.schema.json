{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "authors_or_organization", "date", "source_type", "canonical_url", "doi", "version", "accessed", "last_verified", "status", "claims_supported", "limitations", "related_topics", "unit_ids", "used_in", "local_copy", "sha256"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "title": {"type": "string", "minLength": 1},
    "authors_or_organization": {"type": "string", "minLength": 1},
    "date": {"type": ["string", "null"]},
    "source_type": {"type": "string", "minLength": 1},
    "canonical_url": {"type": "string", "pattern": "^https://"},
    "doi": {"type": ["string", "null"]},
    "version": {"type": ["string", "null"]},
    "accessed": {"type": "string", "format": "date"},
    "last_verified": {"type": "string", "format": "date"},
    "status": {"const": "checked"},
    "claims_supported": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "related_topics": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "unit_ids": {"type": "array", "maxItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "used_in": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "local_copy": {"type": ["string", "null"]},
    "sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"}
  }
}
