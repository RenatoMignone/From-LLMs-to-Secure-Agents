{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifests"],
  "properties": {
    "schema_version": {"const": 1},
    "manifests": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^images/.+/manifest\\.yml$"}
    }
  }
}
